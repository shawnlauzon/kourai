#!/usr/bin/env python3
"""kourai-config: read the installation's config. See bin/kourai_config.py."""
import os
import sys

# Never write __pycache__ into the plugin folder.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import kourai_config  # noqa: E402

sys.exit(kourai_config.main(sys.argv[1:]))
