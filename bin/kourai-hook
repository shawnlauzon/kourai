#!/bin/bash
# Runs the installed copy of a gate hook (docs/UPDATING.md): kourai-hook <name>.sh [args...]
# Refuses a copy whose hash differs from the one the installer recorded.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export KOURAI_BIN=$here
dir=$("$here/kourai-config" get paths.hooks_dir)
version=$("$here/kourai-config" get install.version)
name=${1:?usage: kourai-hook <name>.sh [args...]}
shift
file="$dir/$version/$name"
[ -f "$file" ] || { echo "kourai-hook: $file is not installed" >&2; exit 1; }
sums="$dir/$version/SHA256SUMS"
if [ -f "$sums" ]; then
  want=$(awk -v n="$name" '$2==n {print $1}' "$sums")
  have=$(shasum -a 256 "$file" | awk '{print $1}')
  [ -n "$want" ] && [ "$want" = "$have" ] || { echo "kourai-hook: $file does not match its recorded hash" >&2; exit 1; }
fi
exec bash "$file" "$@"
